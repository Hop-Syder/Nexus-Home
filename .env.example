# .env.example
# Copy to .env and adjust values for local development and CI.
DJANGO_SECRET_KEY=dev-secret-key-change-me
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DATABASE_URL=postgres://postgres:postgres@db:5432/nexus_home
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=/workspace/Nexus-Home/backend/media

POSTGRES_DB=nexus_home
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

